# ── Database (Neon) ────────────────────────────────────────────
# Pooled connection string — used by the running API.
DATABASE_URL=postgres://user:password@ep-sample-123456-pooler.ap-southeast-1.aws.neon.tech/sparkclean?sslmode=require
# Direct connection string — use for migrations and db:reset (Neon DDL).
DATABASE_URL_DIRECT=postgres://user:password@ep-sample-123456.ap-southeast-1.aws.neon.tech/sparkclean?sslmode=require

# ── Server ─────────────────────────────────────────────────────
PORT=4000
CORS_ORIGIN=https://your-frontend.vercel.app,http://localhost:5173
NODE_ENV=production

# ── Auth ───────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars

# First admin created by the seed script. The seed never overwrites an existing admin.
ADMIN_SEED_EMAIL=admin@sparkclean.com
ADMIN_SEED_PASSWORD=replace-with-a-strong-password

# ── Seeding ────────────────────────────────────────────────────
# db:seed and db:reset refuse to run in production unless this is true.
ALLOW_SEED=false
